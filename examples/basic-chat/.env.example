# Copy this file to .env (python -m basic_chat setup does it) and paste an active API key from AI Studio.
# Keep .env local. Never put the key in browser code or share it in chat.
AIVANA_API_KEY=

# Optional. Leave blank for the SDK's production API (https://api.aivana.ai).
# Use the environment that issued your key. For an approved development key:
# AIVANA_API_BASE=https://dev-developers.aivana.ai
AIVANA_API_BASE=

# Optional. The app listens only on 127.0.0.1.
PORT=3006

# Optional Agent Kit export. Paths are relative to this starter folder (or absolute).
# With this unset, blueprint-definition.json is loaded automatically if present.
# To try the bundled fictional business: AIVANA_BLUEPRINT_FILE=blueprints/landscaping.example.json
AIVANA_BLUEPRINT_FILE=

# Optional. A name for the Agent Kit Blueprint you load, shown as the welcome title and in the browser tab.
# An Agent Kit export has a purpose but no name, so you choose one here: one line, up to 80 characters.
# Ignored when no Blueprint is loaded.
AIVANA_BLUEPRINT_NAME=
